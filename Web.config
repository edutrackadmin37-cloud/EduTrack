<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- ============================================================
	     EduTrack PBL-LMS – Web.config (Production Ready)
	     Framework: .NET Framework 4.8
	     Last Updated: 2026-07-26
	     Fixed: Removed duplicate .woff mimeMap
	     ============================================================ -->

	<!-- ==========================================================
	     APPLICATION SETTINGS
	     ========================================================== -->
	<appSettings>
		<!-- Platform Configuration -->
		<add key="PlatformURL" value="http://localhost/EduTrack" />
		<add key="ApplicationName" value="EduTrack PBL-LMS" />
		<add key="ApplicationVersion" value="1.0.0" />

		<!-- Email Provider & Settings -->
		<add key="EmailProvider" value="smtp" />
		<add key="EmailFrom" value="noreply@edutrack.com" />
		<add key="EmailFromName" value="EduTrack PBL-LMS" />
		<add key="SendGridApiKey" value="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
		<add key="SendGridFromEmail" value="noreply@edutrack.com" />
		<add key="SendGridFromName" value="EduTrack PBL-LMS" />

		<!-- SMS Provider & Settings -->
		<add key="SmsProvider" value="stub" />
		<add key="HubtelClientId" value="your-hubtel-client-id" />
		<add key="HubtelClientSecret" value="your-hubtel-client-secret" />
		<add key="HubtelFrom" value="EduTrack" />
		<add key="TwilioAccountSid" value="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
		<add key="TwilioAuthToken" value="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
		<add key="TwilioPhoneNumber" value="+1234567890" />

		<!-- SMTP Configuration (Fallback) -->
		<add key="SmtpHost" value="smtp.gmail.com" />
		<add key="SmtpPort" value="587" />
		<add key="SmtpUser" value="yourEmail@gmail.com" />
		<add key="SmtpPass" value="yourAppPassword" />
		<add key="SmtpEnableSsl" value="true" />
		<add key="SmtpTimeout" value="30000" />

		<!-- Security & Features -->
		<add key="MaxUploadSizeBytes" value="10485760" />
		<add key="PasswordResetTokenExpiryHours" value="1" />
		<add key="EmailVerificationTokenExpiryHours" value="24" />
		<add key="SessionTimeout" value="60" />
		<add key="RequireEmailVerification" value="true" />
		<add key="RequireAdminApproval" value="true" />
		<add key="AllowSelfRegistration" value="true" />
		<add key="AllowRememberMe" value="true" />

		<!-- Password Policy -->
		<add key="MinPasswordLength" value="8" />
		<add key="RequireUpperCase" value="true" />
		<add key="RequireLowerCase" value="true" />
		<add key="RequireNumbers" value="true" />
		<add key="RequireSpecialChars" value="true" />

		<!-- Maintenance & Debug -->
		<add key="MaintenanceMode" value="false" />
		<add key="MaintenanceMessage" value="System is under maintenance. Please try again later." />
		<add key="EnableDetailedErrors" value="false" />
		<add key="LogLevel" value="Error" />

		<!-- ASP.NET Validation Settings -->
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>

	<!-- ==========================================================
	     CONNECTION STRINGS
	     ========================================================== -->
	<connectionStrings>
		<add
			name="EduTrackDb"
			connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=EduTrack_DB;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=30;Encrypt=False"
			providerName="System.Data.SqlClient" />

		<add
			name="EduTrackConnection"
			connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=EduTrack_DB;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=30;Encrypt=False"
			providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- ==========================================================
	     SYSTEM.NET - SMTP AND NETWORK SETTINGS
	     ========================================================== -->
	<system.net>
		<connectionManagement>
			<add address="*" maxconnection="10" />
		</connectionManagement>

		<mailSettings>
			<smtp from="noreply@edutrack.com" deliveryMethod="Network">
				<network
					host="smtp.gmail.com"
					port="587"
					userName="yourEmail@gmail.com"
					password="yourAppPassword"
					enableSsl="true"
					defaultCredentials="false" />
			</smtp>
		</mailSettings>
	</system.net>

	<!-- ==========================================================
	     SYSTEM.WEB – ASP.NET FRAMEWORK SETTINGS
	     ========================================================== -->
	<system.web>
		<compilation debug="false" targetFramework="4.8" />

		<httpRuntime
			targetFramework="4.8"
			maxRequestLength="10485760"
			requestValidationMode="4.8"
			executionTimeout="300" />

		<authentication mode="Forms">
			<forms
				loginUrl="~/Auth/Login.aspx"
				name=".EduTrackAuth"
				timeout="60"
				slidingExpiration="true"
				protection="All"
				domain="" />
		</authentication>

		<authorization>
			<deny users="?" />
		</authorization>

		<sessionState
			mode="InProc"
			timeout="60"
			cookieless="UseCookies"
			cookieName=".EduTrackSession"
			regenerateExpiredSessionId="true"
			useHostingIdentity="true" />

		<httpCookies
			httpOnlyCookies="true"
			requireSSL="false" />

		<pages
			validateRequest="true"
			enableEventValidation="true"
			enableViewStateMac="true"
			viewStateEncryptionMode="Always" />

		<customErrors mode="Off" defaultRedirect="~/Error.aspx">
			<error statusCode="400" redirect="~/Error.aspx?code=400" />
			<error statusCode="401" redirect="~/Auth/Login.aspx" />
			<error statusCode="403" redirect="~/Error403.aspx" />
			<error statusCode="404" redirect="~/Error404.aspx" />
			<error statusCode="500" redirect="~/Error.aspx?code=500" />
		</customErrors>

		<machineKey
			compatibilityMode="Framework45"
			validationKey="AUTO"
			decryptionKey="AUTO"
			validation="SHA1"
			decryption="AES" />

		<trace
			enabled="false"
			pageOutput="false"
			requestLimit="40"
			localOnly="true" />

		<globalization
			requestEncoding="utf-8"
			responseEncoding="utf-8"
			culture="en-US"
			uiCulture="en-US" />

		<trust level="Full" />
	</system.web>

	<!-- ==========================================================
	     LOCATION TAGS - AUTHORIZATION CONFIGURATION
	     ========================================================== -->

	<!-- AUTH PAGES - PUBLIC ACCESS -->
	<location path="Auth/Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/Register.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/ForgotPassword.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/ResetPassword.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/ChangePassword.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/VerifyEmail.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/Logout.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Auth/UserProfile.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- PUBLIC PAGES - PUBLIC ACCESS -->
	<location path="Default.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/About.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/Contact.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/FAQ.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/Help.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/Documentation.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Pages/Features.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- ERROR PAGES - PUBLIC ACCESS -->
	<location path="Error.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Error403.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Error404.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Maintenance.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- RESOURCES - PUBLIC ACCESS (Static Files) -->
	<location path="Resources">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="scripts">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="styles">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Image">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="fonts">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- API ENDPOINTS - PUBLIC ACCESS -->
	<location path="API">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- ==========================================================
     SYSTEM.WEBSERVER – IIS SETTINGS
     ========================================================== -->
	<system.webServer>
		<!-- Module Configuration -->
		<modules runAllManagedModulesForAllRequests="true" />

		<!-- HTTP Handlers -->
		<handlers>
			<remove name="WebServiceHandlerFactory-Integrated" />
			<remove name="ScriptHandlerFactory" />
			<remove name="ScriptHandlerFactoryAppServices" />
			<remove name="ScriptResource" />
			<add name="ScriptHandlerFactory" verb="*" path="*.asmx" preCondition="integratedMode" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
			<add name="ScriptHandlerFactoryAppServices" verb="*" path="*_AppService.axd" preCondition="integratedMode" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
			<add name="ScriptResource" preCondition="integratedMode" verb="GET,HEAD" path="*/ScriptResource.axd" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
		</handlers>

		<!-- Request Filtering & Security -->
		<security>
			<requestFiltering>
				<!-- Block dangerous file extensions -->
				<fileExtensions>
					<add fileExtension=".config" allowed="false" />
					<add fileExtension=".log" allowed="false" />
					<add fileExtension=".bak" allowed="false" />
					<add fileExtension=".sql" allowed="false" />
					<add fileExtension=".exe" allowed="false" />
					<add fileExtension=".bat" allowed="false" />
				</fileExtensions>
				<!-- Hide sensitive directories -->
				<hiddenSegments>
					<add segment="web.config" />
					<add segment="App_Data" />
					<add segment="App_Code" />
					<add segment="bin" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<!-- HTTP Protocol Headers -->
		<httpProtocol>
			<customHeaders>
				<!-- Remove unnecessary headers for security -->
				<remove name="X-Powered-By" />
				<remove name="X-AspNet-Version" />
				<remove name="X-AspNetMvc-Version" />
				<remove name="Server" />

				<!-- Add security headers -->
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="X-XSS-Protection" value="1; mode=block" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
				<add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
			</customHeaders>
		</httpProtocol>

		<!-- Static Content Caching -->
		<staticContent>
			<clear />
			<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
			<mimeMap fileExtension=".woff" mimeType="application/font-woff" />
			<mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
			<mimeMap fileExtension=".ttf" mimeType="application/font-ttf" />
			<mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
			<mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
			<mimeMap fileExtension=".json" mimeType="application/json" />
		</staticContent>

		<!-- Compression -->
		<urlCompression doStaticCompression="true" doDynamicCompression="true" />

		<!-- Default Document -->
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
				<add value="Default.htm" />
				<add value="index.html" />
				<add value="index.htm" />
			</files>
		</defaultDocument>

		<!-- Directory Browsing -->
		<directoryBrowse enabled="false" />
	</system.webServer>
	<!-- ==========================================================
	     RUNTIME - ASSEMBLY BINDING REDIRECTS
	     ========================================================== -->
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- System.Runtime.CompilerServices.Unsafe -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Runtime.CompilerServices.Unsafe"
					publicKeyToken="b03f5f7f11d50a3a"
					culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>

			<!-- Newtonsoft.Json -->
			<dependentAssembly>
				<assemblyIdentity
					name="Newtonsoft.Json"
					publicKeyToken="30ad4fe6b2a6aeed"
					culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>

			<!-- System.Net.Http -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Net.Http"
					publicKeyToken="b03f5f7f11d50a3a"
					culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.2.0.0" />
			</dependentAssembly>

			<!-- System.Web.Mvc -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Web.Mvc"
					publicKeyToken="31bf3856ad364e35"
					culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
			</dependentAssembly>

			<!-- System.Web.WebPages -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Web.WebPages"
					publicKeyToken="31bf3856ad364e35"
					culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>

		<!-- Runtime Configuration -->
		<legacyUnhandledExceptionPolicy enabled="false" />
		<generatePublisherEvidence enabled="false" />
	</runtime>

	<!-- ==========================================================
	     STARTUP - .NET FRAMEWORK CONFIGURATION
	     ========================================================== -->
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>